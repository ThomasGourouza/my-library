{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011TURQz1dKcvezi2ud1yMzU","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Validate one cleaned chunk file (used by cleaning agents as a self-check).\n3\t\n4\tUsage: python3 validate_chunk.py output/cleaned/chunk-01.json\n5\tExit code 0 = valid, 1 = errors (printed).\n6\t\"\"\"\n7\timport json\n8\timport re\n9\timport sys\n10\timport unicodedata\n11\tfrom pathlib import Path\n12\t\n13\tCATEGORIES = {\"Littérature\", \"Philosophie & psychologie\", \"Histoire\",\n14\t              \"Sciences géopolitiques\", \"Sciences\", \"Mathématiques\"}\n15\tAUDIENCES = {\"enfants\", \"adolescents\", \"adultes\", \"tous\"}\n16\tPERIODS = {\"Antiquité\", \"Moyen Âge\", \"XVIe siècle\", \"XVIIe siècle\",\n17\t           \"XVIIIe siècle\", \"XIXe siècle\", \"XXe siècle\", \"XXIe siècle\"}\n18\tAUTHOR_FIELDS = {\"key\", \"name\", \"birthYear\", \"deathYear\", \"nationality\",\n19\t                 \"language\", \"mainGenre\", \"mainField\", \"period\", \"notes\"}\n20\tBOOK_FIELDS = {\"title\", \"authorKey\", \"category\", \"genre\", \"courant\", \"theme\",\n21\t               \"period\", \"publicationYear\", \"audience\", \"worldview\",\n22\t               \"originalLanguage\", \"notes\", \"enriched\", \"sourceSheets\"}\n23\t\n24\t\n25\tdef norm_key(s):\n26\t    s = unicodedata.normalize(\"NFKD\", s or \"\")\n27\t    s = \"\".join(c for c in s if not unicodedata.combining(c))\n28\t    s = s.replace(\"’\", \"'\").lower()\n29\t    return re.sub(r\"\\s+\", \" \", re.sub(r\"[^a-z0-9']+\", \" \", s)).strip()\n30\t\n31\t\n32\tdef check_year(errors, ctx, label, y, lo=-3000, hi=2026):\n33\t    if y is None:\n34\t        return\n35\t    if not isinstance(y, int) or not (lo <= y <= hi):\n36\t        errors.append(f\"{ctx}: {label} invalide: {y!r}\")\n37\t\n38\t\n39\tdef validate(path: Path):\n40\t    errors = []\n41\t    try:\n42\t        data = json.loads(path.read_text(encoding=\"utf-8\"))\n43\t    except Exception as e:\n44\t        return [f\"JSON illisible: {e}\"]\n45\t\n46\t    for key in (\"chunk\", \"authors\", \"books\"):\n47\t        if key not in data:\n48\t            errors.append(f\"clé racine manquante: {key}\")\n49\t    if errors:\n50\t        return errors\n51\t\n52\t    keys = {}\n53\t    for i, a in enumerate(data[\"authors\"]):\n54\t        ctx = f\"authors[{i}] {a.get('name', '?')!r}\"\n55\t        extra = set(a) - AUTHOR_FIELDS\n56\t        missing = AUTHOR_FIELDS - set(a)\n57\t        if extra:\n58\t            errors.append(f\"{ctx}: champs en trop {sorted(extra)}\")\n59\t        if missing:\n60\t            errors.append(f\"{ctx}: champs manquants {sorted(missing)}\")\n61\t        if not a.get(\"name\") or not str(a.get(\"name\")).strip():\n62\t            errors.append(f\"{ctx}: name vide\")\n63\t        k = a.get(\"key\") or \"\"\n64\t        if not re.fullmatch(r\"[a-z0-9]+(-[a-z0-9]+)*\", k):\n65\t            errors.append(f\"{ctx}: key non kebab-case: {k!r}\")\n66\t        if k in keys:\n67\t            errors.append(f\"{ctx}: key dupliquée {k!r}\")\n68\t        keys[k] = a\n69\t        check_year(errors, ctx, \"birthYear\", a.get(\"birthYear\"))\n70\t        check_year(errors, ctx, \"deathYear\", a.get(\"deathYear\"))\n71\t        b, d = a.get(\"birthYear\"), a.get(\"deathYear\")\n72\t        if b is not None and d is not None and d < b:\n73\t            errors.append(f\"{ctx}: décès avant naissance ({b}..{d})\")\n74\t        if a.get(\"period\") is not None and a[\"period\"] not in PERIODS:\n75\t            errors.append(f\"{ctx}: period hors enum: {a['period']!r}\")\n76\t        if a.get(\"mainField\") is not None and a[\"mainField\"] not in CATEGORIES:\n77\t            errors.append(f\"{ctx}: mainField hors enum: {a['mainField']!r}\")\n78\t\n79\t    seen_books = set()\n80\t    books_per_author = {}\n81\t    enriched_per_author = {}\n82\t    for i, b in enumerate(data[\"books\"]):\n83\t        ctx = f\"books[{i}] {b.get('title', '?')!r}\"\n84\t        extra = set(b) - BOOK_FIELDS\n85\t        missing = BOOK_FIELDS - set(b)\n86\t        if extra:\n87\t            errors.append(f\"{ctx}: champs en trop {sorted(extra)}\")\n88\t        if missing:\n89\t            errors.append(f\"{ctx}: champs manquants {sorted(missing)}\")\n90\t        title = b.get(\"title\")\n91\t        if not title or not str(title).strip():\n92\t            errors.append(f\"{ctx}: title vide\")\n93\t            continue\n94\t        ak = b.get(\"authorKey\")\n95\t        if ak not in keys:\n96\t            errors.append(f\"{ctx}: authorKey inconnu {ak!r}\")\n97\t        if b.get(\"category\") not in CATEGORIES:\n98\t            errors.append(f\"{ctx}: category hors enum: {b.get('category')!r}\")\n99\t        if b.get(\"audience\") not in AUDIENCES:\n100\t            errors.append(f\"{ctx}: audience hors enum: {b.get('audience')!r}\")\n101\t        if b.get(\"period\") is not None and b[\"period\"] not in PERIODS:\n102\t            errors.append(f\"{ctx}: period hors enum: {b['period']!r}\")\n103\t        if b.get(\"worldview\") is not None:\n104\t            errors.append(f\"{ctx}: worldview doit rester null (appliqué au merge)\")\n105\t        check_year(errors, ctx, \"publicationYear\", b.get(\"publicationYear\"))\n106\t        if not isinstance(b.get(\"enriched\"), bool):\n107\t            errors.append(f\"{ctx}: enriched doit être bool\")\n108\t        if not isinstance(b.get(\"sourceSheets\"), list) or not b.get(\"sourceSheets\"):\n109\t            errors.append(f\"{ctx}: sourceSheets doit être une liste non vide\")\n110\t        dup = (ak, norm_key(title))\n111\t        if dup in seen_books:\n112\t            errors.append(f\"{ctx}: doublon (authorKey, titre normalisé)\")\n113\t        seen_books.add(dup)\n114\t        books_per_author[ak] = books_per_author.get(ak, 0) + 1\n115\t        if b.get(\"enriched\"):\n116\t            enriched_per_author[ak] = enriched_per_author.get(ak, 0) + 1\n117\t\n118\t    for k in keys:\n119\t        if books_per_author.get(k, 0) == 0:\n120\t            errors.append(f\"auteur {k!r} sans aucun livre\")\n121\t    for k, n in enriched_per_author.items():\n122\t        if n > 3:\n123\t            errors.append(f\"auteur {k!r}: {n} livres enriched (max 3)\")\n124\t\n125\t    return errors\n126\t\n127\t\n128\tdef main():\n129\t    if len(sys.argv) != 2:\n130\t        sys.exit(\"usage: validate_chunk.py <cleaned-chunk.json>\")\n131\t    path = Path(sys.argv[1])\n132\t    errors = validate(path)\n133\t    data = json.loads(path.read_text(encoding=\"utf-8\")) if not errors or True else {}\n134\t    try:\n135\t        n_a, n_b = len(data.get(\"authors\", [])), len(data.get(\"books\", []))\n136\t        n_d = len(data.get(\"dropped\", []))\n137\t        print(f\"{path.name}: {n_a} auteurs, {n_b} livres, {n_d} écartés\")\n138\t    except Exception:\n139\t        pass\n140\t    if errors:\n141\t        print(f\"ÉCHEC — {len(errors)} erreur(s):\")\n142\t        for e in errors[:60]:\n143\t            print(\"  -\", e)\n144\t        sys.exit(1)\n145\t    print(\"OK\")\n146\t\n147\t\n148\tif __name__ == \"__main__\":\n149\t    main()\n150\t"}]},"parent_tool_use_id":"toolu_01YK7uPdKPDPCUVmHoPbcJPW","session_id":"893f4819-6d94-4f67-849d-3e57eeca4b35","uuid":"6d596ad9-e6e1-4681-a6df-d13f3d58b63f","timestamp":"2026-07-18T18:22:03.114Z","subagent_type":"general-purpose","task_description":"Clean data chunk 02"}

\t    courant: text(\"courant\"),\n53\t    theme: text(\"theme\"),\n54\t    period: text(\"period\"),\n55\t    publicationYear: integer(\"publication_year\"),\n56\t    audience: text(\"audience\").notNull().default(\"adultes\"),\n57\t    worldview: text(\"worldview\"),\n58\t    originalLanguage: text(\"original_language\"),\n59\t    notes: text(\"notes\"),\n60\t    // générés par « Analyse Claude »\n61\t    summary: text(\"summary\"),\n62\t    analysis: text(\"analysis\"),\n63\t    analysisGeneratedAt: text(\"analysis_generated_at\"),\n64\t    // true = ajouté depuis les connaissances du modèle (ligne auteur-seul)\n65\t    enriched: integer(\"enriched\", { mode: \"boolean\" }).notNull().default(false),\n66\t    createdAt: text(\"created_at\")\n67\t      .notNull()\n68\t      .default(sql`(datetime('now'))`),\n69\t    updatedAt: text(\"updated_at\")\n70\t      .notNull()\n71\t      .default(sql`(datetime('now'))`),\n72\t  },\n73\t  (t) => [\n74\t    uniqueIndex(\"books_title_author_unique\").on(t.titleNormalized, t.authorId),\n75\t    index(\"books_author_idx\").on(t.authorId),\n76\t    index(\"books_category_idx\").on(t.category),\n77\t    index(\"books_period_idx\").on(t.period),\n78\t    index(\"books_worldview_idx\").on(t.worldview),\n79\t    index(\"books_audience_idx\").on(t.audience),\n80\t  ]\n81\t);\n82\t\n83\texport const analysisJobs = sqliteTable(\"analysis_jobs\", {\n84\t  id: integer(\"id\").primaryKey({ autoIncrement: true }),\n85\t  bookId: integer(\"book_id\")\n86\t    .notNull()\n87\t    .references(() => books.id, { onDelete: \"cascade\" }),\n88\t  status: text(\"status\").notNull(), // running | done | error\n89\t  error: text(\"error\"),\n90\t  startedAt: text(\"started_at\")\n91\t    .notNull()\n92\t    .default(sql`(datetime('now'))`),\n93\t  finishedAt: text(\"finished_at\"),\n94\t});\n95\t\n96\texport type Author = typeof authors.$inferSelect;\n97\texport type NewAuthor = typeof authors.$inferInsert;\n98\texport type Book = typeof books.$infe
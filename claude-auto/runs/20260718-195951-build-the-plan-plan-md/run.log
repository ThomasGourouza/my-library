{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UTbQDtHrtYzdng3qcVyNTf","type":"tool_result","content":"1\t/**\n2\t * Normalisation de texte partagée (affichage vs clés de recherche/dédup).\n3\t * Miroir des règles du pipeline Python (preclean.py norm_key).\n4\t */\n5\t\n6\t/** Nettoyage d'affichage : NFC, apostrophes typographiques, espaces. */\n7\texport function normalizeText(s: string): string {\n8\t  return s\n9\t    .normalize(\"NFC\")\n10\t    .replace(/'/g, \"’\")\n11\t    .replace(/\\s+/g, \" \")\n12\t    .trim();\n13\t}\n14\t\n15\t/**\n16\t * Clé insensible aux accents/casse/apostrophes — utilisée pour\n17\t * nameNormalized / titleNormalized (dédup + recherche). Jamais affichée.\n18\t */\n19\texport function normalizeKey(s: string): string {\n20\t  return s\n21\t    .normalize(\"NFKD\")\n22\t    .replace(/[̀-ͯ]/g, \"\")\n23\t    .replace(/[’‘]/g, \"'\")\n24\t    .toLowerCase()\n25\t    .replace(/[^a-z0-9']+/g, \" \")\n26\t    .replace(/\\s+/g, \" \")\n27\t    .trim();\n28\t}\n29\t\n30\t/** -428 -> \"428 av. J.-C.\" ; 1913 -> \"1913\" ; null -> \"\" */\n31\texport function formatYear(y: number | null | undefined): string {\n32\t  if (y == null) return \"\";\n33\t  return y < 0 ? `${-y} av. J.-C.` : String(y);\n34\t}\n35\t\n36\t/** (1913, 1960) -> \"1913–1960\" ; (-428, -348) -> \"428–348 av. J.-C.\" */\n37\texport function formatLifespan(\n38\t  birth: number | null | undefined,\n39\t  death: number | null | undefined\n40\t): string {\n41\t  if (birth == null && death == null) return \"\";\n42\t  if (birth != null && death != null) {\n43\t    if (birth < 0 && death < 0) return `${-birth}–${-death} av. J.-C.`;\n44\t    return `${formatYear(birth)}–${formatYear(death)}`;\n45\t  }\n46\t  if (birth != null) return `né(e) en ${formatYear(birth)}`;\n47\t  return `mort(e) en ${formatYear(death)}`;\n48\t}\n49\t"}]},"parent_tool_use_id":"toolu_019Dztf1QJqsmcpw1bL16AsT","session_id":"893f4819-6d94-4f67-849d-3e57eeca4b35","uuid":"d372b4c4-4
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E2HEDzMbs9WFonztHjQhsJ","type":"tool_result","content":"1\timport { and, asc, desc, eq, like, or, sql, type SQL } from \"drizzle-orm\";\n2\timport { db } from \"@/db\";\n3\timport {\n4\t  authors,\n5\t  books,\n6\t  type Author,\n7\t  type AuthorWithCount,\n8\t  type Book,\n9\t  type BookWithAuthor,\n10\t} from \"@/db/schema\";\n11\timport { normalizeKey } from \"@/lib/normalize\";\n12\timport type { BookQuery } from \"@/lib/validation\";\n13\t\n14\t/**\n15\t * Liste des livres avec leur auteur, filtrée/triée côté SQL.\n16\t * Recherche insensible aux accents via les colonnes *Normalized.\n17\t */\n18\texport function listBooks(filters: BookQuery = {}): BookWithAuthor[] {\n19\t  const conds: SQL[] = [];\n20\t  if (filters.search) {\n21\t    const k = `%${normalizeKey(filters.search)}%`;\n22\t    conds.push(\n23\t      or(like(books.titleNormalized, k), like(authors.nameNormalized, k))!\n24\t    );\n25\t  }\n26\t  if (filters.category) conds.push(eq(books.category, filters.category));\n27\t  if (filters.genre) conds.push(eq(books.genre, filters.genre));\n28\t  if (filters.courant) conds.push(eq(books.courant, filters.courant));\n29\t  if (filters.period) conds.push(eq(books.period, filters.period));\n30\t  if (filters.audience) conds.push(eq(books.audience, filters.audience));\n31\t  if (filters.worldview) conds.push(eq(books.worldview, filters.worldview));\n32\t  if (filters.authorId) conds.push(eq(books.authorId, filters.authorId));\n33\t\n34\t  const dir = filters.dir === \"desc\" ? desc : asc;\n35\t  const orderCols = {\n36\t    title: books.titleNormalized,\n37\t    author: authors.nameNormalized,\n38\t    period: books.period,\n39\t    publicationYear: books.publicationYear,\n40\t    createdAt: books.createdAt,\n41\t  } as const;\n42\t  const orderCol = orderCols[filters.sort ?? \"title\"];\n43\t\n44\t  const rows = db\n45\t    .select({ book: books, author: authors })\n46\t    .from(books)\n47\t    .innerJoin(authors, eq(books.authorId, authors.id))\n48\t    .where(conds.length ? and(...conds) : undefined)\n49\t    .orderBy(dir(orderCol), asc(books.titleNormalized))\n50\t    .all();\n51\t  return rows.map((r) => ({ ...r.book, author: r.author }));\n52\t}\n53\t\n54\texport function getBook(id: number): BookWithAuthor | undefined {\n55\t  const row = db\n56\t    .select({ book: books, author: authors })\n57\t    .from(books)\n58\t    .innerJoin(authors, eq(books.authorId, authors.id))\n59\t    .where(eq(books.id, id))\n60\t    .get();\n61\t  return row ? { ...row.book, author: row.author } : undefined;\n62\t}\n63\t\n64\texport interface AuthorFilters {\n65\t  search?: string;\n66\t  mainField?: string;\n67\t  mainGenre?: string;\n68\t  period?: string;\n69\t  nationality?: string;\n70\t  language?: string;\n71\t}\n72\t\n73\texport function listAuthors(filters: AuthorFilters = {}): AuthorWithCount[] {\n74\t  const conds: SQL[] = [];\n75\t  if (filters.search)\n76\t    conds.push(like(authors.nameNormalized, `%${normalizeKey(filters.search)}%`));\n77\t  if (filters.mainField) conds.push(eq(authors.mainField, filters.mainField));\n78\t  if (filters.mainGenre) conds.push(eq(authors.mainGenre, filters.mainGenre));\n79\t  if (filters.period) conds.push(eq(authors.period, filters.period));\n80\t  if (filters.nationality) conds.push(eq(authors.nationality, filters.nationality));\n81\t  if (filters.language) conds.push(eq(authors.language, filters.language));\n82\t\n83\t  const rows = db\n84\t    .select({\n85\t      author: authors,\n86\t      bookCount: sql<number>`count(${books.id})`.as(\"book_count\"),\n87\t    })\n88\t    .from(authors)\n89\t    .leftJoin(books, eq(books.authorId, authors.id))\n90\t    .where(conds.length ? and(...conds) : undefined)\n91\t    .groupBy(authors.id)\n92\t    .orderBy(asc(authors.nameNormalized))\n93\t    .all();\n94\t  return rows.map((r) => ({ ...r.author, bookCount: r.bookCount }));\n95\t}\n96\t\n97\texport function getAuthor(\n98\t  id: number\n99\t): (Author & { books: Book[] }) | undefined {\n100\t  const author = db.select().from(authors).where(eq(authors.id, id)).get();\n101\t  if (!author) return undefined;\n102\t  const authorBooks = db\n103\t    .select()\n104\t    .from(books)\n105\t    .where(eq(books.authorId, id))\n106\t    .orderBy(asc(books.titleNormalized))\n107\t    .all();\n108\t  return { ...author, books: authorBooks };\n109\t}\n110\t\n111\texport function countBooksByAuthor(authorId: number): number {\n112\t  const row = db\n113\t    .select({ n: sql<number>`count(*)` })\n114\t    .from(books)\n115\t    .where(eq(books.authorId, authorId))\n116\t    .get();\n117\t  return row?.n ?? 0;\n118\t}\n119\t\n120\t/** Valeurs distinctes pour alimenter les popovers de filtres. */\n121\texport function getFilterOptions(): {\n122\t  genres: string[];\n123\t  courants: string[];\n124\t  themes: string[];\n125\t  nationalities: string[];\n126\t  languages: string[];\n127\t  mainFields: string[];\n128\t  mainGenres: string[];\n129\t} {\n130\t  const distinct = (col: SQL<string | null>, table: typeof books | typeof authors) =>\n131\t    db\n132\t      .selectDistinct({ v: col })\n133\t      .from(table)\n134\t      .all()\n135\t      .map((r) => r.v)\n136\t      .filter((v): v is string => v != null && v !== \"\")\n137\t      .sort((a, b) => a.localeCompare(b, \"fr\"));\n138\t  return {\n139\t    genres: distinct(sql`${books.genre}`, books),\n140\t    courants: distinct(sql`${books.courant}`, books),\n141\t    themes: distinct(sql`${books.theme}`, books),\n142\t    nationalities: distinct(sql`${authors.nationality}`, authors),\n143\t    languages: distinct(sql`${authors.language}`, authors),\n144\t    mainFields: distinct(sql`${authors.mainField}`, authors),\n145\t    mainGenres: distinct(sql`${authors.mainGenre}`, authors),\n146\t  };\n147\t}\n148\t"}]},"parent_tool_use_id":"toolu_01GtMpSuwmtsjsqUwu9ZNPnJ","session_id":"893f4819-6d94-4f67-849d-3e57eeca4b35","uuid":"4393db8d-8d